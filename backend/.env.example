# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Supabase -> Connect -> Session pooler (port 5432, IPv4). Direct and Transaction pooler
# use IPv6, which Heroku and most home networks lack. Paste the string as is: the
# postgresql:// prefix is converted automatically. URL-encode special characters in the password.
DATABASE_URL=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Comma-separated Discord user ids allowed to use /api/admin/*.
ADMIN_DISCORD_IDS=
